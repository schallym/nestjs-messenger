{
  "name": "@schally/nestjs-messenger-transport-google-pubsub",
  "version": "0.1.0",
  "description": "Google Cloud Pub/Sub transport for @schally/nestjs-messenger.",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "messenger",
    "google-cloud",
    "pubsub",
    "gcp",
    "transport",
    "message-queue",
    "symfony-messenger",
    "typescript"
  ],
  "homepage": "https://github.com/schallym/nestjs-messenger/tree/main/packages/transport-google-pubsub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schallym/nestjs-messenger.git",
    "directory": "packages/transport-google-pubsub"
  },
  "bugs": {
    "url": "https://github.com/schallym/nestjs-messenger/issues"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo .turbo"
  },
  "peerDependencies": {
    "@schally/nestjs-messenger": "^0.1.0"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@schally/nestjs-messenger": "workspace:*",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0"
  }
}

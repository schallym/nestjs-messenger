{
  "name": "@schally/nestjs-messenger",
  "version": "1.0.0",
  "description": "A unified message bus for NestJS with pluggable transports, modelled on Symfony Messenger.",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "messenger",
    "message-bus",
    "message-queue",
    "symfony-messenger",
    "cqrs",
    "redis-streams",
    "worker",
    "middleware",
    "retry",
    "typescript"
  ],
  "homepage": "https://github.com/schallym/nestjs-messenger/tree/main/packages/messenger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schallym/nestjs-messenger.git",
    "directory": "packages/messenger"
  },
  "bugs": {
    "url": "https://github.com/schallym/nestjs-messenger/issues"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ],
      "cli": [
        "./dist/cli/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo .turbo"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": ">=0.1",
    "nest-commander": ">=3",
    "jest": ">=29"
  },
  "peerDependenciesMeta": {
    "nest-commander": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/testing": "^11.1.26",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nest-commander": "^3.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node", "jest"],
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@schally/nestjs-messenger": ["../messenger/src/index.ts"],
      "@schally/nestjs-messenger/testing": ["../messenger/src/testing/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

{
  "name": "@schally/nestjs-messenger-transport-kafka",
  "version": "1.1.0",
  "description": "Apache Kafka transport for @schally/nestjs-messenger (kafkajs).",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "messenger",
    "kafka",
    "kafkajs",
    "transport",
    "message-queue",
    "event-streaming",
    "symfony-messenger",
    "typescript"
  ],
  "homepage": "https://github.com/schallym/nestjs-messenger/tree/main/packages/transport-kafka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schallym/nestjs-messenger.git",
    "directory": "packages/transport-kafka"
  },
  "bugs": {
    "url": "https://github.com/schallym/nestjs-messenger/issues"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo .turbo"
  },
  "peerDependencies": {
    "@schally/nestjs-messenger": "^0.1.0"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@schally/nestjs-messenger": "workspace:*",
    "@types/jest": "^29.5.14",
    "jest": "^30.4.2"
  }
}

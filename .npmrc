# The repo targets Node >= 24 (see .nvmrc / engines), but we do not hard-fail
# installs on older local Node versions — CI is the source of truth for the
# engine. Flip to true once every contributor is on Node 24.
engine-strict=false

# Keep the dependency tree honest: no silent hoisting of undeclared deps.
shamefully-hoist=false
auto-install-peers=true
strict-peer-dependencies=false

# NestJS 12 ships ESM-only. Jest 30 can require(esm) on Node >= 24.9, but only when
# vm.SourceTextModule exists, which Node still gates behind --experimental-vm-modules.
# Set it here (pnpm exports it as NODE_OPTIONS for every script) rather than in each
# package's test script, so there is a single source of truth across the workspace.
# --no-experimental-strip-types: on Node >= 22.18 Jest first tries to load jest.config.ts via
# native type stripping, which cannot parse its ESM syntax inside a CommonJS package and prints
# a misleading "set type: module" warning before falling back to ts-node. Go straight to ts-node,
# the loader this repo actually configures.
# pnpm replaces (does not append to) an inherited NODE_OPTIONS, and runners that bypass pnpm
# (IDE test runners, `npx jest`) do not see these flags and must set them themselves.
node-options=--experimental-vm-modules --disable-warning=ExperimentalWarning --no-experimental-strip-types

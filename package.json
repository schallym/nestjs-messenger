{
  "name": "nestjs-messenger",
  "version": "0.0.0",
  "private": true,
  "description": "Symfony Messenger's developer experience for the NestJS ecosystem.",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "lint": "eslint . --max-warnings 0 && prettier --check \"**/*.{ts,mjs,cjs,json,yml,yaml}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,mjs,cjs,json,yml,yaml}\"",
    "dev:brokers": "docker compose -f e2e/docker-compose.yml up -d --wait",
    "dev:brokers:down": "docker compose -f e2e/docker-compose.yml down -v",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
